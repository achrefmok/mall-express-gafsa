# ─────────────────────────────────────────────────────────────
# Mall Express Gafsa — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# Tableau de bord Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────

# URL du projet Supabase (ex. https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » — exposée au navigateur, protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role » — NE JAMAIS exposer au navigateur ni committer.
# Utilisée uniquement côté serveur (tâches de maintenance, expiration des bons plans).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (utilisée pour les redirections OAuth, le sitemap, les métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret partagé protégeant /api/cron/* (générer : openssl rand -hex 32)
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Relais automatique des directs Facebook
#
# Une boutique relie sa page une fois ; ensuite ses directs apparaissent
# seuls sur le site. Sans ces variables, la section reste masquée dans les
# réglages vendeur et le relais manuel (coller le lien) continue de marcher.
#
# App ID : developers.facebook.com → votre app → Paramètres → Général
# Le secret ne porte pas NEXT_PUBLIC_ : il ne doit jamais partir au navigateur.
#
# Le jeton de vérification est une chaîne que vous choisissez ; recopiez-la
# à l'identique dans Meta → Webhooks → Modifier l'abonnement.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ─────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Détection immédiate par webhook, au lieu de la vérification planifiée.
# À ne poser (=1) que si votre application Meta possède « pages_manage_metadata » :
# sans cette permission, Facebook répond « Invalid Scopes: pages_manage_metadata »
# et bloque tout le dialogue d'autorisation.
# Le relais fonctionne très bien sans, à un quart d'heure près.
FACEBOOK_ENABLE_WEBHOOK=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Coordonnées affichées sur /presentation
# Laisser vide masque la ligne correspondante : mieux vaut aucun contact
# qu'un numéro qui ne répond pas. L'adresse a « Gafsa, Tunisie » par défaut.
# ─────────────────────────────────────────────────────────────
# Nom de l'exploitant, affiche sur /confidentialite comme responsable du
# traitement. Une politique sans responsable nomme n'a aucune valeur, et Meta
# refuse l'application en revue.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# ─────────────────────────────────────────────────────────────
# Live — serveurs ICE pour la diffusion caméra (WebRTC)
# STUN public par défaut. Pour un usage réel derrière NAT symétrique,
# renseigner un serveur TURN (metered.ca, coturn auto-hébergé, Cloudflare Calls…).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
