  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@serwist/next": "^9.2.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.4",
    "serwist": "^9.2.1",
